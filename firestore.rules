rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validRecord(userId, recordId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'userId', 'title', 'description', 'eventAt', 'createdAt', 'updatedAt', 'latitude', 'longitude'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'description', 'eventAt', 'createdAt', 'updatedAt', 'latitude', 'longitude'
        ])
        && data.id == recordId
        && data.userId == userId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() <= 2000
        && data.eventAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }

    match /users/{userId}/registros/{recordId} {
      allow get, list: if signedInAs(userId) && resource.data.userId == userId;
      allow create: if signedInAs(userId) && validRecord(userId, recordId);
      allow update: if signedInAs(userId)
        && resource.data.userId == userId
        && validRecord(userId, recordId);
      // Deleting a not-yet-created record is a safe idempotent no-op. This is
      // needed when an offline create is replaced by a queued delete.
      allow delete: if signedInAs(userId)
        && (resource == null || resource.data.userId == userId);
    }
  }
}
